{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PMBOK Project Charter",
  "description": "Machine-readable PMBOK 7 Project Charter. Auto-maintained by the Agentic PMBOK Toolkit.",
  "type": "object",
  "required": ["project_name", "version", "last_updated", "objectives", "scope", "stakeholders", "high_level_risks", "budget_estimate", "timeline"],
  "additionalProperties": false,
  "properties": {
    "project_name":  { "type": "string" },
    "project_id":    { "type": "string", "pattern": "^PROJ-[0-9]{3,6}$" },
    "version":       { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "description": "Semantic version e.g. 1.3" },
    "last_updated":  { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status":        { "type": "string", "enum": ["Draft", "Active", "On Hold", "Closed"] },
    "project_manager": { "type": "string" },
    "sponsor":         { "type": "string" },

    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "success_criteria"],
        "properties": {
          "id":               { "type": "string" },
          "description":      { "type": "string" },
          "success_criteria": { "type": "string" }
        }
      }
    },

    "scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope":     { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },

    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "influence"],
        "properties": {
          "name":     { "type": "string" },
          "role":     { "type": "string" },
          "influence": { "type": "string", "enum": ["Low", "Medium", "High"] },
          "interest":  { "type": "string", "enum": ["Low", "Medium", "High"] }
        }
      }
    },

    "high_level_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "probability", "impact"],
        "properties": {
          "description": { "type": "string" },
          "probability": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
          "impact":      { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] }
        }
      }
    },

    "budget_estimate": {
      "type": "object",
      "required": ["currency", "total"],
      "properties": {
        "currency":    { "type": "string" },
        "total":       { "type": "number" },
        "contingency": { "type": "number" },
        "breakdown":   { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },

    "timeline": {
      "type": "object",
      "required": ["start_date", "end_date", "milestones"],
      "properties": {
        "start_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end_date":   { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "date"],
            "properties": {
              "name":   { "type": "string" },
              "date":   { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "status": { "type": "string", "enum": ["Pending", "In Progress", "Complete", "Delayed"] }
            }
          }
        }
      }
    },

    "assumptions": { "type": "array", "items": { "type": "string" } },
    "constraints":  { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } }
  }
}
